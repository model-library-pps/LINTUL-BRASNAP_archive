********************************************************************
* PLANAP.DAT                                                       *
* Input file for BRASN1_1.FOR                                      *
* Initial values and parameter values                              *
* Parameter values are derived from experimental data of the       * 
* variety JET NEUF. Parameterization is described in:              *
* Habekotte, 1996. Description, parameterization and listing of    *
* LINTUL-BRASNAP 1.1, Quantitative Approaches in Systems Analysis  *
* AB-DLO/PE, Wageningen, XX pp.                                    *
* For some parameters the original source of the experimental data *
* are given                                                        *
********************************************************************

********************************************************************
* initial conditions                                               *
********************************************************************

*---Day of sowing and startday for integration of development;
*   default value for the Netherlands is 237. (25-8)
SWD  = 237.

*---Startday for integration of total dry matter in spring
*   default value for the Netherlands is 447. (22-3)
STIM  = 447.

*---Initial value of the state of vernalization
VF = 0.

*---Initial value of leaf area index (lai, m2 m-2) in spring at 
*   time = stim; calculated through (tdw*0.57*0.00981) 
*   (Habekotte & Smid, 1992); 
*   default value for the Netherlands is 1.12 m2 m-2

SLAI  = 1.12

*---Initial value of total dry matter (g m-2) in spring
*   (de Boer & Langenhuysen,1985);
*   default value for the Netherlands is 200. g m-2
TDW = 200.

*******************************************************************
* Experimental data of total crop dry matter, seed dry matter and *
* leaf area index during the growing season, that can be used for *
* model evaluation; dummy values are filled in;                   *
* see rernap.dat for an example.                                   *
*******************************************************************
*---Total dry matter (g m-2) at harvest dates, including dead leaves: 
TDW_OBS = -99.

*---Seed weight (g m-2) at harvest dates:  
SEEDW_OBS = -99.

*---Leaf area index (m2 m-2):
LAI_OBS = -99.

*********************************************************************
*    COMMON DATA                                                    *
*********************************************************************

**** Parameters for phenological development of the crop ************
*    (Habekotte, 1996a); Tx (C); ATx (d-1 C-1); MVR (d-1 C-1); DLx (h) 
TB1 = 0.30236            
TB2 = 0.54435
TB3 = 4.9163
TB4 = 0.6870
AT1 = 0.0077212325
AT2 = 0.00200831      
AT3 = 0.0051036     
AT4 = 0.0014651     
TMIN  = -3.71823
TOP1  =  0.72595
TOP2  =  5.37697
TMAX  = 17.20219
MVR   = 0.01455395
DLB   = 5.7416
DLOPT = 14.8014

**** Parameters for growth ******************************************

*---light use efficiency related to dvs (g MJ-1) (Habekotte, 1996b)
*   (1.145 is the value at stim in stead of at dvs=1.0, see model):
LUEDVS = -1.000,   0.0,
          0.999,   0.0,
          1.0  ,   1.145,
          2.0  ,   2.6818,
          3.5  ,   1.9573,
          4.2  ,   0.0,
          6.0  ,   0.0

*---Increase of FPAR with development stage after dvs = 3.5
*   based on: (d(fpar)/d(dvso), Habekotte & Smid, 1992)
FPDVS = 0.184

*---Extinction coefficient of light related to the leaf area index
*   before flowering (Habekotte & Smid, 1992)
KLAI = 0.986

*---Reflection coefficient of the (green) canopy before flowering
*   (Yates & Steven, 1987; Leach, 1989)
REFGBF = 0.046

*---Reflection coefficient of the (green) canopy after flowering
*   (Yates & Steven, 1987; Leach, 1987)
REFGAF = 0.072

*---Flower area per flower (m2) (Habekotte, 1996)
SPFL= 0.000213

*---Duration of flowering per flower (°Cd)(Habekotte, 1996)
DPFL = 30.5       ! with base temperature: TB = 4.9163

*---Mean duration of the flowering period (Cd) (Habekotte, 1996a)
FPER = 195.94      ! with base temperature TB = 4.9163

*---Parameters for calculation of the cumulative number of 
*   flowers (1 m-2): linearly related to total dry 
*   matter at the onset of flowering (Habekotte, 1993):
PF1 = 6380.
PF2 = 7.34     

* distribution of dry matter to the leaves after the 
* initial phase of LAI development (LAI > 0.75) 
* (Habekotte & Smid, 1992; de Boer & Langenhuysen, 1985):
FLDVS = 0.0 ,   0.0,
        1.0 ,   0.752,
        1.125,  0.752,
        1.425,  0.363,
        1.58,   0.330,
        1.78,   0.298,
        2.01,   0.265,
        2.321,  0.160,
        2.32101,0.0,
        6.0 ,   0.0

*---Relative increase rate of LAI (Cd-1) when LAI < 0.75
* (after Boer & Langenhuysen, 1985):
RLAI = 0.007315

*---Specific leaf area of young leaves (m2 g-1)
*   (Habekotte & Smid, 1992)
SLA   = 0.0177

*---Fraction of total crop dry matter growth distributed to 
*   the seeds as a function of the development stage 
*   (Habekotte & Smid, 1992)
FSDVS = 0.,    0.,
        2.41,  0.,
        2.81,  0.115,
        3.30,  1.0,
        5.0,   1.0

*---Initial meen seed weight (GCU g per 1000.) at the end of flowering
*   (at DVS=3.) (Habekotte & Smid, 1992)
IMSW = 0.254

*---Potential individual seed growth per 1000 seeds (g Cd-1)
*   related to DVS since EF (Habekotte & Smid, 1992):
PDMSWT = 0.000, 0.0,      2.999, 0.0,
  3.000, 0.0028382,       3.110, 0.006364, 
  3.256, 0.015386,        3.330, 0.020086,        3.505, 0.020086,           
  3.549, 0.017917,        
  3.769, 0.004841,        4.355, 0.000045,        6.000, 0.0000

*---Factor for pdmsw (only used for sensitivity analysis):
FPDMSW = 1.0      

*---Fraction reserve carbohydrates of total dry matter (in GCU)
*   just after flowering (at dvs=3.3) (Habekotte & Smid, 1992)
FRECAR = 0.049     

*---Maximum relative depletion rate of the reserve pool in GCU (d-1)
*   (DRECAR = -MDREC*RECAR)
*   (Habekotte & Smid, 1992)
MDREC = 0.0524

*---Parameters for calculation of the number of pods with seeds (m-2),
*   linearly related to total dry matter at the end of flowering:
*   (Habekotte, 1993)
NP1 = -1021.
NP2 = 6.76

*---Potential number of seeds per pod (Mendham et al., 1984):
PSPP = 35.

*---Parameters for calculation of the number of seeds (m-2)
*   linearly related to dry matter production during the critical 
*   period for seed set: a period from the onset of flowering (OF) 
*   until 350 Cd since onset of flowering 
*   (Habekotte, 1996b).
NS1 = -7663.
NS2 =  184.1     

*---Conversion factor of glucose units dry matter into
*   green crop units of dry matter (=GRQG-1)
*   (Habekotte & Smid, 1992 and Penning de Vries et al., 1989):
CONVG = 0.671

*---Protein content of the seeds (circa constant)
*   (Triboi-Blondel & Ribailier, 1988)
FPROT = 0.22

*---Oil-content of seeds at final harvest (average value of variety
*   Jet Neuf from 1980-1989 in the flevopolders (RIJP-reports).
FOILM  = 0.428

*---Conversion factors of glucose units required for seed dry matter: 
*---oil (after Penning de Vries et al., 1989):
GO = 3.189 
*---protein:
GP = 1.887
*---carbohydrates:
GC = 1.275

*---The relative change of the oil content of the seeds related to the 
*   naximum oil content at final harvest (foilm) and related 
*   to the temperature sum (tsseed) since the moment of seed initiation 
*   (estimated at 1/3 of the flowering period when DVS = 2.333
*   (after Triboi-Blondel & Ribaillier, 1988; Habekotte, 1996).
ROILTB =   0.0,0.00, 275.,0.051, 373.,0.41,  438.,0.69, 490.,0.82,
         539.0,0.94, 588.,0.980, 641.,1.00, 1500.,1.00
